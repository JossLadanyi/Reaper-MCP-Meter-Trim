/*
   TRIM AND METER STEREO (Rose Hill Tribe)
   STEREO VU (RMS) / Peak meter and integrated trim control plugin
   
   INSTALLATION: In REAPER, go to the Options menu › Show REAPER resource path in explorer/finder. Open the Effects folder and move this file there.
   Open REAPER’s FX browser (press Shift + F or click FX on a track). For the first time press F5 to refresh the plugin list. Search for plugin Trim & Meter
   
   USAGE: Insert it between any two plugins in your track's FX chain. In the Mixer (MCP), right-click the plugin in the slot list and check Show embedded UI in MCP
   Live Level Bar: Displays a horizontal VU or Peak meter that spans from green to red as the signal passes through. The left value shows the current peak, the center
   value shows all-time peak, the right value shows the gain.
   Click anywhere on the meter bar in the mixer slot and drag up or down to adjust the gain. Double-Click: Resets the meter readouts.
   To set the base level, open the plugin and adjust Base Level (dBFS). You can also switch between VU Meter mode (300ms RMS integration with mechanical ballistics) 
   and Peak Meter mode (instantaneous sample peak detection).
   
   INTERNALS:
   - VU sample peak calculations is standard 300 ms RMS integration across combined stereo channels (0.5 * (L^2 + R^2)).
   - standard +3.0103 dB calibration factor is applied, so that a sine wave at your chosen Base Level (e.g., -18 dBFS) matches 0 VU on the reference ZenoMOD and 
   Blenheim meters.
   - the digital readout catches peak VU levels instantly, holds them for 2 seconds, and decays smoothly (15 dB/s), making levels clear and easy to read
   - the integration engine uses a true 2nd-order mechanical needle simulation (zeta = 0.65, omega_n = 2pi / 0.300s). This captures the exact inertia, acceleration, and
   overshoot behavior of physical VU movements matching ZenoMOD and Blenheim.
*/

desc: Trim & Meter Stereo
slider1:0<-24,24,0.1>Gain Trim (dB)
slider2:-18<-36,0,1>Base Level (dBFS)
slider3:0<0,1,1{VU (RMS),Peak}>Meter Mode

in_pin:left
in_pin:right
out_pin:left
out_pin:right

@init
vu_x_L = 0; vu_v_L = 0;
vu_x_R = 0; vu_v_R = 0;

peak_hold_val_L = -100; peak_hold_time_L = 0;
peak_hold_val_R = -100; peak_hold_time_R = 0;

abs_peak_val_L = -100;
abs_peak_val_R = -100;

last_play_state = 0;
last_click = 0;
dbl_click = 0;
last_gfx_time = time_precise();

max_db_frame_L = -150;
max_db_frame_R = -150;

@slider
gain_amp = 10^(slider1 / 20);
mode != slider3 ? (
  abs_peak_val_L = -100;
  abs_peak_val_R = -100;
);
mode = slider3;

@block
// Recalculate linear gain directly from slider1 on every audio block
gain_amp = 10^(slider1 / 20);

(play_state & 1) && !(last_play_state & 1) ? (
  vu_x_L = 0; vu_v_L = 0;
  vu_x_R = 0; vu_v_R = 0;
  peak_hold_val_L = -100; peak_hold_val_R = -100;
  abs_peak_val_L = -100; abs_peak_val_R = -100;
  max_db_frame_L = -150; max_db_frame_R = -150;
);
last_play_state = play_state;

@sample
s0 = spl0 * gain_amp;
s1 = spl1 * gain_amp;
spl0 = s0;
spl1 = s1;

mode == 0 ? (
  abs_s0 = abs(s0);
  abs_s1 = abs(s1);
  dt_s = 1.0 / srate;
  omega_n = 20.943951;

  acc_L = (omega_n * omega_n) * (abs_s0 - vu_x_L) - (1.3 * omega_n) * vu_v_L;
  vu_v_L += acc_L * dt_s;
  vu_x_L += vu_v_L * dt_s;
  vu_x_L = max(0, vu_x_L);

  acc_R = (omega_n * omega_n) * (abs_s1 - vu_x_R) - (1.3 * omega_n) * vu_v_R;
  vu_v_R += acc_R * dt_s;
  vu_x_R += vu_v_R * dt_s;
  vu_x_R = max(0, vu_x_R);

  current_db_L = 20 * log10(max(vu_x_L, 0.000000000001)) + 3.9224;
  current_db_R = 20 * log10(max(vu_x_R, 0.000000000001)) + 3.9224;
) : (
  current_db_L = 20 * log10(max(abs(s0), 0.000000000001));
  current_db_R = 20 * log10(max(abs(s1), 0.000000000001));
);

max_db_frame_L = max(max_db_frame_L, current_db_L);
max_db_frame_R = max(max_db_frame_R, current_db_R);

@gfx 150 48
gfx_setfont(1, "Arial", 13, 0);
gfx_setfont(2, "Arial", 15, 'b');

gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.10;
gfx_rect(0, 0, gfx_w, gfx_h);

bar_space = 2;
bar_h = (gfx_h-bar_space*3)/2;
bar_y_L = bar_space;
bar_y_R = bar_y_L + bar_h + bar_space;

gfx_setfont(1);
text_y_L = bar_y_L + floor((bar_h - gfx_texth) / 2);
text_y_R = bar_y_R + floor((bar_h - gfx_texth) / 2);

db_rel_L = max_db_frame_L - slider2;
db_rel_R = max_db_frame_R - slider2;

now = time_precise();
dt = max(0.001, now - last_gfx_time);
last_gfx_time = now;

max_db_frame_L > peak_hold_val_L ? (
  peak_hold_val_L = max_db_frame_L;
  peak_hold_time_L = now;
) : (
  now - peak_hold_time_L > 1.2 ? (
    peak_hold_val_L = max(-100, peak_hold_val_L - 12 * dt);
  );
);

max_db_frame_R > peak_hold_val_R ? (
  peak_hold_val_R = max_db_frame_R;
  peak_hold_time_R = now;
) : (
  now - peak_hold_time_R > 1.2 ? (
    peak_hold_val_R = max(-100, peak_hold_val_R - 12 * dt);
  );
);

max_db_frame_L = -150;
max_db_frame_R = -150;

peak_hold_rel_L = peak_hold_val_L - slider2;
peak_hold_rel_R = peak_hold_val_R - slider2;

abs(peak_hold_rel_L) < 0.05 ? peak_hold_rel_L = 0.0;
abs(peak_hold_rel_R) < 0.05 ? peak_hold_rel_R = 0.0;

peak_hold_val_L > -59.9 && peak_hold_rel_L > abs_peak_val_L ? abs_peak_val_L = peak_hold_rel_L;
peak_hold_val_R > -59.9 && peak_hold_rel_R > abs_peak_val_R ? abs_peak_val_R = peak_hold_rel_R;

min_rel = -40; max_rel = 10;
range = max_rel - min_rel;

zero_pct = (0 - min_rel) / range;
zero_x = 2 + (gfx_w - 4) * zero_pct;

gfx_r = 0.05; gfx_g = 0.05; gfx_b = 0.05;
gfx_rect(2, bar_y_L, gfx_w - 4, bar_h);
gfx_rect(2, bar_y_R, gfx_w - 4, bar_h);

val_pct_L = max(0, min(1, (db_rel_L - min_rel) / range));
green_pct_L = min(val_pct_L, zero_pct);
green_w_L = (gfx_w - 4) * green_pct_L;
gfx_r = 0.12; gfx_g = 0.52; gfx_b = 0.15;
gfx_rect(2, bar_y_L, green_w_L, bar_h);

db_rel_L > 0.05 ? (
  red_pct_L = min(val_pct_L, 1) - zero_pct;
  red_w_L = (gfx_w - 4) * red_pct_L;
  gfx_r = 0.65; gfx_g = 0.12; gfx_b = 0.12;
  gfx_rect(2 + green_w_L, bar_y_L, red_w_L, bar_h);
);

val_pct_R = max(0, min(1, (db_rel_R - min_rel) / range));
green_pct_R = min(val_pct_R, zero_pct);
green_w_R = (gfx_w - 4) * green_pct_R;
gfx_r = 0.12; gfx_g = 0.52; gfx_b = 0.15;
gfx_rect(2, bar_y_R, green_w_R, bar_h);

db_rel_R > 0.05 ? (
  red_pct_R = min(val_pct_R, 1) - zero_pct;
  red_w_R = (gfx_w - 4) * red_pct_R;
  gfx_r = 0.65; gfx_g = 0.12; gfx_b = 0.12;
  gfx_rect(2 + green_w_R, bar_y_R, red_w_R, bar_h);
);

gfx_r = 0.35; gfx_g = 0.35; gfx_b = 0.35;
gfx_line(zero_x, bar_y_L, zero_x, bar_y_R + bar_h);

// Left Channel: Current Peak (Left-aligned on Left bar)
gfx_setfont(1);
peak_hold_rel_L > 0.049 ? (gfx_r=1.0; gfx_g=0.3; gfx_b=0.3) : (gfx_r=0.95; gfx_g=0.95; gfx_b=0.95);
gfx_x = 5; gfx_y = text_y_L;
peak_hold_val_L <= -59.9 ? gfx_drawstr("-Inf") : gfx_drawnumber(peak_hold_rel_L, 1);

// Right Channel: Current Peak (Left-aligned on Right bar)
peak_hold_rel_R > 0.049 ? (gfx_r=1.0; gfx_g=0.3; gfx_b=0.3) : (gfx_r=0.95; gfx_g=0.95; gfx_b=0.95);
gfx_x = 5; gfx_y = text_y_R;
peak_hold_val_R <= -59.9 ? gfx_drawstr("-Inf") : gfx_drawnumber(peak_hold_rel_R, 1);

// Left Channel: All-Time Peak (Centered on Left bar)
abs_peak_val_L > 0.049 ? (gfx_r=1.0; gfx_g=0.3; gfx_b=0.3) : (gfx_r=0.95; gfx_g=0.95; gfx_b=0.95);
#pk_str_L = "";
abs_peak_val_L <= -59.9 ? sprintf(#pk_str_L, "-Inf") : sprintf(#pk_str_L, "%.1f", abs_peak_val_L);
gfx_measurestr(#pk_str_L, pk_w_L, pk_h_L);
gfx_x = floor((gfx_w - pk_w_L) / 2); gfx_y = text_y_L;
gfx_drawstr(#pk_str_L);

// Right Channel: All-Time Peak (Centered on Right bar)
abs_peak_val_R > 0.049 ? (gfx_r=1.0; gfx_g=0.3; gfx_b=0.3) : (gfx_r=0.95; gfx_g=0.95; gfx_b=0.95);
#pk_str_R = "";
abs_peak_val_R <= -59.9 ? sprintf(#pk_str_R, "-Inf") : sprintf(#pk_str_R, "%.1f", abs_peak_val_R);
gfx_measurestr(#pk_str_R, pk_w_R, pk_h_R);
gfx_x = floor((gfx_w - pk_w_R) / 2); gfx_y = text_y_R;
gfx_drawstr(#pk_str_R);

// --- TRIM GAIN VALUE (Bold, Larger, Centered Vertically on the Right) ---
gfx_setfont(2);
gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;

#tr_str = "";
sprintf(#tr_str, "%.1f", slider1);
gfx_measurestr(#tr_str, str_w, str_h);
gfx_x = gfx_w - str_w - 6;
gfx_y = floor((bar_y_L + (bar_y_R + bar_h) - str_h) / 2);
gfx_drawstr(#tr_str);

// --- DRAG TO ADJUST GAIN LOGIC ---
mouse_cap & 1 ? (
  !last_cap ? (
    start_y = mouse_y; 
    start_val = slider1;
    
    // Double-Click reset check (resets meters)
    time_precise() - last_click < 0.25 ? (
      dbl_click = 1;
      abs_peak_val_L = -100; abs_peak_val_R = -100;
      peak_hold_val_L = -100; peak_hold_val_R = -100;
      max_db_frame_L = -150; max_db_frame_R = -150;
    ) : dbl_click = 0;
    
    last_click = time_precise();
  );
  
  dbl_click == 0 ? (
    sens = (mouse_cap & 8) ? 0.01 : 0.05;
    delta = (start_y - mouse_y) * sens;
    slider1 = max(-24, min(24, start_val + delta));
    slider_automate(slider1);
  );
);

last_cap = mouse_cap & 1;